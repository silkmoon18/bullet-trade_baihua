# Fork local bridge, NOT the upstream HTTP gateway. No secrets in this file.
# Existing deployments: merge differences into your PRIVATE .data/.env;
# preserve the original ledger path, account key, public token and allowlist.
QMT_SERVER_TYPE=big_qmt
QMT_SERVER_HOST=127.0.0.1
QMT_SERVER_PORT=58620
QMT_SERVER_TOKEN=
QMT_ACCOUNT_ID=
QMT_ACCOUNT_TYPE=STOCK
BIG_QMT_TRANSPORT=bridge
BIG_QMT_BRIDGE_PORT=9001
BIG_QMT_GATEWAY_PASSWORD=

# Start read-only. Native script also defaults ENABLE_TRADING/ENABLE_CANCEL=False.
QMT_STRATEGY_TRADING_ENABLED=false
# 仅供已确认模拟账户用首笔真实策略订单生成能力证据；验证后立即改回false。
QMT_STRATEGY_SIMULATION_VALIDATION_ENABLED=false
# Do not replace an existing database with a new empty path.
# QMT_STRATEGY_LEDGER_DB=<existing private database path>
# Do not reuse XTQUANT_DIRECT evidence for BIG_QMT.
# QMT_STRATEGY_CAPABILITIES_FILE=<new independently verified BIG_QMT evidence>
# QMT_STRATEGY_ENABLED_IDS=<existing approved strategy IDs>
# Default STRICT rejects broker fills without a usable price. To count confirmed
# fill quantities despite a zero price, enable the SAME fallback on either QMT
# account type: an estimated unit price is booked into cash/cost/P&L; estimated
# returns are explicitly labeled non-precise, never treated as broker prices.
# Normal priced fills are unaffected. Verify broker cash before real-money use.
QMT_STRATEGY_UNPRICED_FILL_POLICY=ZERO_FALLBACK
# 策略事件始终写入服务器本地日志；此开关仅控制飞书分发。
QMT_STRATEGY_NOTIFY_FEISHU=true
